# Domínio servido pelo nginx da VPS (Task 12) — API na raiz, assets em /config/ e /assets/
DOMAIN=bora-marcar.duckdns.org
# Imagem do BFF (o deploy troca a tag pelo SHA)
BFF_IMAGE=ghcr.io/m4rdine/bora-marcar-bff:latest
APP_VERSION=local
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=60
UPSTREAM_TIMEOUT_MS=5000
LOG_LEVEL=info
# MinIO (só no .env da VPS; nunca no repositório)
# MINIO_ROOT_PASSWORD é lido com `source` (sem aspas) pelos scripts — use um token único, sem
# espaços, $, crases ou #. `openssl rand -base64 32` já gera um alfabeto seguro para isso.
MINIO_ROOT_USER=boramarcar
MINIO_ROOT_PASSWORD=troque-esta-senha-longa
# CERTBOT_EMAIL é opcional: a VPS já tem conta ACME registrada, então o certbot reaproveita.
# Se ficar vazio, o script roda sem `-m` (--register-unsafely-without-email).
CERTBOT_EMAIL=
