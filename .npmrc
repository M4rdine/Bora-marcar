engine-strict=true
auto-install-peers=true
# Forces a flat, npm-style node_modules (no .pnpm virtual-store nesting).
# Needed because react-native/jest-expo's transformIgnorePatterns regex only
# expects one "node_modules/" segment per path; pnpm's default store nests
# node_modules twice and breaks it. See task-1-3-report.md, Tooling notes.
node-linker=hoisted
