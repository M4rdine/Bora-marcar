# Modo de acesso à API: "direct" chama a Open-Meteo diretamente (padrão);
# "bff" tentaria usar o backend com cache do Plano 4 — hoje cai em "direct" com aviso.
# EXPO_PUBLIC_API_MODE=direct

# URL do BFF (Plano 4). Só é usada quando EXPO_PUBLIC_API_MODE=bff.
# EXPO_PUBLIC_BFF_URL=https://bff.exemplo.com

# URL base para assets estáticos servidos pelo BFF/CDN (Plano 4).
# EXPO_PUBLIC_ASSETS_URL=https://assets.exemplo.com
